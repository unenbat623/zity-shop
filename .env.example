# ── Zity Delguur App — Environment Variables ──────────────────────────────────

# Odoo ERP Integration
VITE_ODOO_URL=https://odoo.zity.mn
VITE_ODOO_DB=zity_delguur_db
VITE_ODOO_USERNAME=api_admin@zity.mn
# Use API key (not password) for production — Settings > Technical > API Keys
VITE_ODOO_API_KEY=your_odoo_api_key_here

# Zity Chef Complex Integration (optional — for recipe kit cross-linking)
VITE_ZITY_CHEF_API_URL=http://localhost:3002
VITE_ZITY_CHEF_SUPABASE_URL=https://fggypcgctpwjvtutejzc.supabase.co
VITE_ZITY_CHEF_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# QPay Payment Gateway (for production)
VITE_QPAY_MERCHANT_ID=your_merchant_id
VITE_QPAY_INVOICE_CODE=ZITY_DELGUUR

# App Environment
VITE_APP_NAME=Zity Delguur
VITE_APP_ENV=development
