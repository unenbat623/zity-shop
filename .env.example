# ── Zity Delguur App — Environment Variables ─────────────────────────────────
#
# ⚠️ ЧУХАЛ: VITE_ угтвартай бүх хувьсагч browser bundle-д ИЛ орно.
# Нууц түлхүүр (DB password, service role key, OAuth client secret, SMTP
# password, Odoo API key) энд ХЭЗЭЭ Ч оруулахгүй — эдгээр нь backend-ийн
# орчинд байх ёстой. Дэлгэрэнгүйг docs/chef-backend-env.md-ээс үзнэ үү.

# ── Zity Chef backend ────────────────────────────────────────────────────────
# Chef backend-ийн public base URL (эндээс /api/... замууд дуудагдана).
# Dev үед Vite proxy (/api/zity-chef) ашиглагддаг тул CORS тохируулах шаардлагагүй.
VITE_ZITY_CHEF_API_URL=http://localhost:3002
# Production (Vercel дээр тохируулна):
# VITE_ZITY_CHEF_API_URL=https://zity-chef.vercel.app

# Chef backend дээр энэ URL нь ихэвчлэн VITE_API_URL гэж нэрлэгддэг.

# ── Supabase Auth (бүртгэл / нэвтрэлт) ───────────────────────────────────────
# Эдгээрийг тохируулаагүй бол нэвтрэлт бүхэлдээ идэвхгүй болж, дэлгэц дээр
# тохиргооны заавар харагдана. Зөвхөн public утга — anon key нь publishable key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# OAuth буцах хаяг. Хоосон орхивол одоогийн хаягийг (window.location.origin)
# ашиглана — production дээр ЭНЭ НЬ ЗӨВ тул хоосон орхих нь хамгийн найдвартай.
# Утга нь одоогийн хаягтай зөрвөл автоматаар үл тоомсорлоно (localhost-ын
# утгыг санамсаргүй production руу хуулахаас хамгаална).
VITE_AUTH_REDIRECT_URL=

# ⚠️ Supabase dashboard дээр ЗААВАЛ хийх тохиргоо:
#   Authentication → URL Configuration → Redirect URLs дээр доорхыг БҮГДИЙГ нэмнэ:
#     http://localhost:3005/login
#     https://zity-shop.vercel.app/login
#     https://zity-shop.vercel.app/**        (Vercel preview deploy-д)
#
#   Бүртгэгдээгүй хаяг руу буцаах гэвэл Supabase нь Site URL руу буцаадаг.
#   Хэрэв Site URL нь Zity Chef бол Delguur-ээс нэвтэрсэн хэрэглэгч Chef дээр очно.
#   Authentication → Providers → Google:
#     Google Cloud Console дээрх callback = https://your-project.supabase.co/auth/v1/callback

# ── Admin эрх ────────────────────────────────────────────────────────────────
# /odoo-admin dashboard руу нэвтрэх эрхтэй имэйлүүд (таслалаар тусгаарлана).
# Тохируулаагүй бол нэвтэрсэн ДУРЫН хэрэглэгч admin хуудсыг үзэж чадна —
# production дээр заавал тохируулна.
VITE_ADMIN_EMAILS=admin@zity.mn

# ── Odoo ERP (зөвхөн харуулах зорилготой мэдээлэл) ───────────────────────────
# Frontend Odoo руу ШУУД хандахгүй (CORS + нууц түлхүүр ил гарна).
# Эдгээр нь admin dashboard дээр холболтын мэдээлэл харуулахад л ашиглагдана.
# Бодит холболтыг Chef backend дээрх /api/odoo/* proxy хийнэ.
VITE_ODOO_URL=https://odoo.zity.mn
VITE_ODOO_DB=zity_delguur_db
VITE_ODOO_USERNAME=api_admin@zity.mn
# VITE_ODOO_API_KEY — ЭНД ОРУУЛАХГҮЙ. Backend env дээр ODOO_API_KEY гэж хадгална.

# ── App ──────────────────────────────────────────────────────────────────────
VITE_APP_NAME=Zity Delguur
VITE_APP_ENV=development

# Апп-ын public хаяг. OG зураг, canonical, sitemap-д ашиглагдана.
VITE_SITE_URL=https://zity-shop.vercel.app

# ── ⚠️ Демо горим ────────────────────────────────────────────────────────────
# Асаалттай үед:
#   • онлайн төлбөр 1 секундын дараа "амжилттай" болно — БОДИТ ГҮЙЛГЭЭ ХИЙГДЭХГҮЙ
#   • захиалга цагаар өөрөө "бэлтгэж байна → хүргэгдсэн" болж, бэлнээр төлөх
#     захиалга автоматаар "төлөгдсөн"-д тооцогдоно
#   • Odoo bridge олдоогүй ч синк амжилттай мэт харагдана
#
# Тохируулаагүй бол: dev дээр АСААЛТТАЙ, production дээр УНТРААЛТТАЙ.
# Production дээр 'true' болгож ХЭЗЭЭ Ч болохгүй — мөнгө төлөөгүй захиалга
# төлөгдсөнд тооцогдож, бодит хүргэлтгүйгээр хаагдана.
VITE_DEMO_MODE=true
