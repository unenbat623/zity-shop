# ── Zity Delguur App — Environment Variables ──────────────────────────────────

# Odoo ERP Integration
VITE_ODOO_URL=https://odoo.zity.mn
VITE_ODOO_DB=zity_delguur_db
VITE_ODOO_USERNAME=api_admin@zity.mn
# Use API key (not password) for production — Settings > Technical > API Keys
VITE_ODOO_API_KEY=your_odoo_api_key_here

# Zity Chef Complex Integration
# Frontend-д зөвхөн public/base API URL орно. DB URL, JWT secret, SMTP password,
# CCORE client secret, AI API key зэрэг backend secret-үүдийг VITE_* болгож
# оруулахгүй.
VITE_ZITY_CHEF_API_URL=http://localhost:3002
# Production жишээ:
# VITE_ZITY_CHEF_API_URL=https://tbon.tavanbogd.com
# Chef backend-ийн өөрийн env дээрх VITE_API_URL нь Delguur талд
# VITE_ZITY_CHEF_API_URL гэж map хийгдэнэ.

# Optional: Supabase public config зөвхөн frontend шууд Supabase Auth ашиглах үед.
# Энэ app одоогоор Chef backend API-аар дамжиж байгаа тул ихэнх тохиолдолд хэрэггүй.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_publishable_anon_key

# QPay Payment Gateway (for production)
VITE_QPAY_MERCHANT_ID=your_merchant_id
VITE_QPAY_INVOICE_CODE=ZITY_DELGUUR

# App Environment
VITE_APP_NAME=Zity Delguur
VITE_APP_ENV=development
